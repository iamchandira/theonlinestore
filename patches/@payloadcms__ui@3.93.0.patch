--- a/dist/forms/Form/reduceToSerializableFields.js
+++ b/dist/forms/Form/reduceToSerializableFields.js
@@ -7,6 +7,13 @@ const sanitizeField = incomingField => {
   for (const key of blacklistedKeys) {
     delete field[key];
   }
+  // Array/blocks rows carry their own customComponents (e.g. RowLabel elements); strip them too
+  if (Array.isArray(field.rows)) {
+    field.rows = field.rows.map(({
+      customComponents: _customComponents,
+      ...row
+    }) => row);
+  }
   return field;
 };
