# /srv/theonlinestore/.env  (on the server only — never commit the real file)
# Fill every value, then: chmod 600 /srv/theonlinestore/.env

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# The public address of the store (no trailing slash). Used in emails, payment links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://theonlinestore.lk

# Database (docker-compose.db.yml). Use a long random password: openssl rand -hex 24
POSTGRES_PASSWORD=
# Write the same password again here, in full (systemd does not expand ${…} variables)
DATABASE_URL=postgres://theonlinestore:<same password as above>@127.0.0.1:5432/theonlinestore

# Signs logins and private links. Generate once and keep it: openssl rand -hex 32
PAYLOAD_SECRET=

# Uploaded product photos, review photos and bank slips (outside the build folder; backed up nightly)
UPLOADS_DIR=/srv/theonlinestore/uploads

# Email (Zoho, Amazon SES, Resend, Brevo… any SMTP). Set SPF/DKIM for your domain in DNS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@theonlinestore.lk
EMAIL_FROM_NAME=The Online Store

# Payments (also editable in Admin › Settings › Payments by a Super Admin; these win when set)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# NEVER set ALLOW_TEST_GATEWAY here. The test gateway cannot run on a real domain.
