# Database (local Postgres from docker-compose.yml, port 5434)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/theonlinestore
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public site URL (used for SEO, emails, payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev admin created by: pnpm seed:admin

# Email (Sprint 3). Local dev: Mailpit from docker-compose (inbox at http://localhost:8026).
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@theonlinestore.lk
EMAIL_FROM_NAME=The Online Store

# Payments (Sprint 5). Leave empty locally: the built-in test gateway stands in.
# Any value here overrides what is saved in Admin › Settings › Payments.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PRIVATE_KEY=
KOKO_PUBLIC_KEY=
MINTPAY_MERCHANT_ID=
MINTPAY_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Uploaded files (media/, review-media/, private/). Defaults to the project folder; `pnpm start` needs the
# absolute path because the standalone server runs inside .next/standalone. Production: /srv/theonlinestore/uploads
UPLOADS_DIR=

# Shopping assistant (chatbot): Gemini API key from https://aistudio.google.com/apikey. Empty = chat hidden.
GEMINI_API_KEY=
# Optional: folder for the DB-IP location files (pnpm geoip:update). Default ./.geoip
# GEOIP_DIR=
