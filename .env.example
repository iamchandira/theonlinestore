# Database (local Postgres from docker-compose.yml, port 5434)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/theonlinestore
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public site URL (used for SEO, emails, payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev admin created by: pnpm seed:admin
SEED_ADMIN_EMAIL=dev-admin@theonlinestore.test
SEED_ADMIN_PASSWORD=choose-a-local-test-password

# Email (Sprint 3). Local dev: Mailpit from docker-compose (inbox at http://localhost:8026).
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@theonlinestore.lk
EMAIL_FROM_NAME=The Online Store
